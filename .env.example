# Server Port (Auto-assigned by Render or default 3000)
PORT=3000

# PostgreSQL Connection URL (Provided by Render PostgreSQL, Supabase, Neon, or local PostgreSQL)
# Example: postgresql://username:password@dpg-xxxx.render.com/roterpay_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/roterpay

# Environment Mode (production / development)
NODE_ENV=production
