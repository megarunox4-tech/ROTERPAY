# ==========================================
# ROTERPAY PRODUCTION & RENDER ENVIRONMENT CONFIGURATION
# ==========================================

# Server Port (Render injects PORT automatically)
PORT=3000

# Environment Mode: 'production' on Render
NODE_ENV=production

# Render PostgreSQL Internal or External Connection String (from roterpay-db)
# Example: postgresql://roterpay_db_user:password@dpg-xxx.oregon-postgres.render.com/roterpay_db
DATABASE_URL=postgresql://user:password@host:5432/roterpay_db

# Secure Random Secret for Signing User & Admin JWT Tokens
JWT_SECRET=roterpay_super_secret_jwt_key_2026

# Administrator Account Credentials (Used to seed PostgreSQL admins table on first launch)
ADMIN_USERNAME=admin
ADMIN_PASSCODE=admin123
